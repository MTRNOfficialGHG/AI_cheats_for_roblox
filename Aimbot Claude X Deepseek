type ToggleController = { refresh: () -> () }

local function addToggle(labelText: string, key: string, onChanged: ((boolean) -> ())?): ToggleController
	local row = makeRow(32, labelText)
	local button = makeButton(row, 64, 8, "")
	local function refresh()
		local value = (Config :: any)[key] :: boolean
		button.Text = value and "ON" or "OFF"
		button.BackgroundColor3 = value and THEME.Accent or THEME.Off
	end
	button.Activated:Connect(function()
		(Config :: any)[key] = not (Config :: any)[key]
		refresh()
		if onChanged then onChanged((Config :: any)[key]) end
	end)
	refresh()
	return { refresh = refresh }
end

type SliderController = { setEnabled: (boolean) -> (), setValue: (number) -> () }

local function addSlider(labelText: string, min: number, max: number, key: string,
	format: (number) -> string, onChanged: (() -> ())?): SliderController

	local row = makeRow(50, labelText)
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.fromOffset(90, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = THEME.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	}) :: TextLabel

	local track = create("Frame", {
		Position = UDim2.new(0, 10, 0, 36),
		Size = UDim2.new(1, -20, 0, 6),
		BackgroundColor3 = THEME.Off,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(3) }) :: Frame
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(3) }) :: Frame
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = THEME.Text,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(7) }) :: Frame

	local enabled = true

	local function applyValue(value: number)
		;(Config :: any)[key] = value
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = format(value)
		if onChanged then onChanged() end
	end

	local function setFromAlpha(alpha: number)
		alpha = math.clamp(alpha, 0, 1)
		applyValue(min + (max - min) * alpha)
	end

	local dragging = false
	local function update(input: InputObject)
		if not enabled then return end
		setFromAlpha((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end

	track.InputBegan:Connect(function(input)
		if not enabled then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)

	applyValue((Config :: any)[key])

	return {
		setEnabled = function(v: boolean)
			enabled = v
			row.BackgroundTransparency = v and 0 or 0.55
			track.BackgroundTransparency = v and 0 or 0.4
			fill.BackgroundTransparency = v and 0 or 0.4
			knob.BackgroundTransparency = v and 0 or 0.4
			valueLabel.TextTransparency = v and 0 or 0.4
			local label = row:FindFirstChild("Label")
			if label and label:IsA("TextLabel") then
				label.TextTransparency = v and 0 or 0.4
			end
		end,
		setValue = applyValue,
	}
end

local function addCycle(labelText: string, options: { string }, getter: () -> string, setter: (string) -> ())
	local row = makeRow(32, labelText)
	local button = makeButton(row, 110, 8, getter())
	button.BackgroundColor3 = THEME.Accent
	button.Activated:Connect(function()
		local index = table.find(options, getter()) or 1
