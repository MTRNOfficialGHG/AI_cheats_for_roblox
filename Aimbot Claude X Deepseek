local function ensureEspCache(player: Player): EspCache
	local cache = espCache[player]
	if cache then return cache end
	cache = {
		box = Drawing.new("Square"),
		boxFill = Drawing.new("Square"),
		hpBg = Drawing.new("Square"),
		hpFill = Drawing.new("Square"),
		name = Drawing.new("Text"),
		bones = {},
	}
	cache.box.Thickness = 1
	cache.box.Filled = false
	cache.box.Color = Color3.fromRGB(255, 255, 255)
	cache.boxFill.Filled = true
	cache.boxFill.Color = Color3.fromRGB(0, 0, 0)
	cache.boxFill.Transparency = 0.85
	cache.hpBg.Filled = true
	cache.hpBg.Color = Color3.fromRGB(0, 0, 0)
	cache.hpFill.Filled = true
	cache.name.Size = 13
	cache.name.Center = true
	cache.name.Outline = true
	cache.name.OutlineColor = Color3.fromRGB(0, 0, 0)
	cache.name.Font = 2
	espCache[player] = cache
	return cache
end

local function ensureBoneCount(cache: EspCache, n: number)
	while #cache.bones < n do
		local line = Drawing.new("Line")
		line.Thickness = 1.5
		line.Color = Color3.fromRGB(255, 255, 255)
		line.Transparency = 1
		table.insert(cache.bones, line)
	end
end

local function hideEspCache(cache: EspCache)
	cache.box.Visible = false
	cache.boxFill.Visible = false
	cache.hpBg.Visible = false
	cache.hpFill.Visible = false
	cache.name.Visible = false
	for _, line in ipairs(cache.bones) do
		line.Visible = false
	end
end

local function destroyEspCache(player: Player)
	local cache = espCache[player]
	if not cache then return end
	cache.box:Remove()
	cache.boxFill:Remove()
	cache.hpBg:Remove()
	cache.hpFill:Remove()
	cache.name:Remove()
	for _, line in ipairs(cache.bones) do line:Remove() end
	espCache[player] = nil
end

Players.PlayerRemoving:Connect(destroyEspCache)

local function healthColor(ratio: number): Color3
	ratio = math.clamp(ratio, 0, 1)
	if ratio >= 0.5 then
		local t = (ratio - 0.5) * 2
		return Color3.fromRGB(math.floor(255 * (1 - t)), 255, 0)
	else
		local t = ratio * 2
		return Color3.fromRGB(255, math.floor(255 * t), 0)
	end
end

local function screenPoint(worldPos: Vector3): (Vector2?, boolean)
	local sp, onScreen = camera:WorldToViewportPoint(worldPos)
	if not onScreen or sp.Z <= 0 then return nil, false end
	return Vector2.new(sp.X, sp.Y + guiInset.Y), true
end

local function updateEspForPlayer(player: Player)
	local cache = ensureEspCache(player)

	if not Config.ESP or player == localPlayer then
		hideEspCache(cache)
		return
	end
	if Config.ESPTeamCheck and player.Team and player.Team == localPlayer.Team then
		hideEspCache(cache)
		return
	end

	local char = player.Character
	if not char then hideEspCache(cache); return end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then hideEspCache(cache); return end

	-- Bounding-Box via Model:GetBoundingBox
	local ok, cf, size = pcall(function()
		local c, s = char:GetBoundingBox()
		return c, s
	end)
	if not ok then hideEspCache(cache); return end

	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local anyOnScreen = false
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz = -1, 1, 2 do
				local worldPos = (cf * CFrame.new(size.X/2*sx, size.Y/2*sy, size.Z/2*sz)).Position
				local pt, on = screenPoint(worldPos)
				if on and pt then
					anyOnScreen = true
					if pt.X < minX then minX = pt.X end
					if pt.Y < minY then minY = pt.Y end
					if pt.X > maxX then maxX = pt.X end
					if pt.Y > maxY then maxY = pt.Y end
				end
			end
		end
	end

	if not anyOnScreen or maxX <= minX or maxY <= minY then
		hideEspCache(cache)
		return
	end

	local boxW = maxX - minX
	local boxH = maxY - minY

	-- Box
	if Config.ESPBox then
		cache.boxFill.Visible = true
		cache.boxFill.Position = Vector2.new(minX, minY)
		cache.boxFill.Size = Vector2.new(boxW, boxH)
		cache.box.Visible = true
		cache.box.Position = Vector2.new(minX, minY)
		cache.box.Size = Vector2.new(boxW, boxH)
		cache.box.Color = Color3.fromRGB(255, 255, 255)
	else
		cache.box.Visible = false
		cache.boxFill.Visible = false
	end

	-- HP-Bar (rechts neben der Box)
	if Config.ESPHealth then
		local hpRatio = humanoid.Health / math.max(humanoid.MaxHealth, 1)
		local barX = maxX + 3
		local barY = minY
		local barW = 3
		local barH = boxH
		local fillH = barH * hpRatio

		cache.hpBg.Visible = true
		cache.hpBg.Position = Vector2.new(barX - 1, barY - 1)
		cache.hpBg.Size = Vector2.new(barW + 2, barH + 2)

		cache.hpFill.Visible = true
		cache.hpFill.Position = Vector2.new(barX, barY + (barH - fillH))
		cache.hpFill.Size = Vector2.new(barW, fillH)
		cache.hpFill.Color = healthColor(hpRatio)
	else
		cache.hpBg.Visible = false
		cache.hpFill.Visible = false
	end

	-- Name
	if Config.ESPName then
		cache.name.Visible = true
		cache.name.Text = string.format("%s [%d]", player.Name, math.floor(humanoid.Health))
		cache.name.Position = Vector2.new(minX + boxW / 2, minY - 16)
		cache.name.Color = Color3.fromRGB(255, 255, 255)
	else
		cache.name.Visible = false
	end

	-- Skeleton
	if Config.ESPSkeleton then
		local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15
		local skeleton = isR15 and R15_SKELETON or R6_SKELETON
		ensureBoneCount(cache, #skeleton)

		for i, pair in ipairs(skeleton) do
			local line = cache.bones[i]
			local p1 = char:FindFirstChild(pair[1])
			local p2 = char:FindFirstChild(pair[2])
			if p1 and p1:IsA("BasePart") and p2 and p2:IsA("BasePart") then
				local pt1, on1 = screenPoint(p1.Position)
				local pt2, on2 = screenPoint(p2.Position)
				if on1 and on2 and pt1 and pt2 then
					line.Visible = true
					line.From = pt1
					line.To = pt2
					line.Color = Color3.fromRGB(255, 255, 255)
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end
		end
		for i = #skeleton + 1, #cache.bones do
			cache.bones[i].Visible = false
		end
	else
		for _, line in ipairs(cache.bones) do line.Visible = false end
	end
end

------------------------------------------------------------------
-- Aim Assist
------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = false

local function getBonePart(character: Model): BasePart?
	if Config.Bone == "Head" then
		return character:FindFirstChild("Head") :: BasePart?
	end
	return (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")) :: BasePart?
end

local function getAimCenter(): Vector2
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		return camera.ViewportSize / 2
	end
	return UserInputService:GetMouseLocation()
end

local function isVisible(part: BasePart, character: Model): boolean
	local origin = camera.CFrame.Position
	rayParams.FilterDescendantsInstances = { localPlayer.Character, character }
	local result = workspace:Raycast(origin, part.Position - origin, rayParams)
	return result == nil or result.Instance:IsDescendantOf(character)
end

-- Performance-Fix: Ziel nicht jeden Frame, sondern alle 50ms
local cachedTarget: BasePart? = nil
local lastTargetCheck = 0

local function getClosestTarget(): BasePart?
	local center = getAimCenter()
	local bestPart: BasePart? = nil
	local bestDistance = Config.Radius

	for _, player in ipairs(Players:GetPlayers()) do
		if player == localPlayer then continue end
		if Config.TeamCheck and player.Team and player.Team == localPlayer.Team then continue end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not character or not humanoid or humanoid.Health <= 0 then continue end

		local part = getBonePart(character)
		if not part then continue end

		local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen then continue end

		local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
		if distance < bestDistance and (not Config.WallCheck or isVisible(part, character)) then
			bestDistance = distance
			bestPart = part
		end
	end
	return bestPart
end

local function getTargetCached(now: number): BasePart?
	if now - lastTargetCheck < 0.05 then return cachedTarget end
	lastTargetCheck = now
	cachedTarget = getClosestTarget()
	return cachedTarget
end

