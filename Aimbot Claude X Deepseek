------------------------------------------------------------------
-- Ziel-Logik
------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getBonePart(character)
    if Config.Bone == "Head" then
        return character:FindFirstChild("Head")
    end
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function getAimCenter()
    local camera = workspace.CurrentCamera
    if not camera then return Vector2.zero end
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return camera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end

local function isVisible(part, character)
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local origin = camera.CFrame.Position
    local result = workspace:Raycast(origin, part.Position - origin, rayParams)
    return result == nil or result.Instance:IsDescendantOf(character)
end

local SKIP_NAMES = { Handle = true }

local function getClosestTarget()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local center = getAimCenter()
    local myChar = localPlayer.Character
    rayParams.FilterDescendantsInstances = myChar and { myChar } or {}

    local bestPart, bestDistance = nil, Config.Radius

    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        if Config.TeamCheck and player.Team ~= nil and player.Team == localPlayer.Team then
            continue
        end

        local character = player.Character
        if not character then continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local part = getBonePart(character)
        if not part then continue end

        local distance = math.huge
        for _, bodyPart in ipairs(character:GetChildren()) do
            if bodyPart:IsA("BasePart") and not SKIP_NAMES[bodyPart.Name] then
                local screenPos, onScreen = camera:WorldToViewportPoint(bodyPart.Position)
                if onScreen then
                    local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if d < distance then distance = d end
                end
            end
        end

        if distance < bestDistance and (not Config.WallCheck or isVisible(part, character)) then
            bestDistance = distance
            bestPart     = part
        end
    end
    return bestPart
end

------------------------------------------------------------------
-- Hauptschleife
------------------------------------------------------------------
RunService:BindToRenderStep("SmartTargetingAssist", Enum.RenderPriority.Camera.Value + 1, function(dt)
    -- FOV-Kreis
    if hasDrawing and fovCircle then
        local center = getAimCenter()
        fovCircle.Position = center
        fovCircle.Visible  = Config.ShowFOV
        if Config.ShowFOV then
            fovCircle.Radius = Config.Radius
            fovCircle.Color  = Config.FOVColor
        end
    end

    if not Config.Enabled then return end
    if Config.Mode == "Keybind" and not keyHeld then return end

    local target = getClosestTarget()
    if not target then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local goal  = CFrame.lookAt(camera.CFrame.Position, target.Position)
    local alpha = 1 - (Config.Smoothing * 0.97) ^ (dt * 60)
    camera.CFrame = camera.CFrame:Lerp(goal, alpha)
end)

