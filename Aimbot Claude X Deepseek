local layoutCounter = 0

local function makeRow(height, labelText)
    layoutCounter += 1
    local row = create("Frame", {
        LayoutOrder      = layoutCounter,
        Size             = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = THEME.Row,
        BorderSizePixel  = 0,
        Parent           = content,
    }, { corner(8) })

    create("TextLabel", {
        Name             = "Label",
        Position         = UDim2.fromOffset(10, 0),
        Size             = UDim2.new(0.45, 0, 0, 32),
        BackgroundTransparency = 1,
        Font             = Enum.Font.Gotham,
        Text             = labelText,
        TextSize         = 13,
        TextColor3       = THEME.Text,
        TextXAlignment   = Enum.TextXAlignment.Left,
        Parent           = row,
    })
    return row
end

local function makeButton(parent, width, offsetFromRight, text)
    return create("TextButton", {
        AnchorPoint      = Vector2.new(1, 0),
        Position         = UDim2.new(1, -offsetFromRight, 0, 4),
        Size             = UDim2.fromOffset(width, 24),
        BackgroundColor3 = THEME.Off,
        Font             = Enum.Font.GothamMedium,
        Text             = text,
        TextSize         = 12,
        TextColor3       = THEME.Text,
        AutoButtonColor  = true,
        Parent           = parent,
    }, { corner(6) })
end

local function addToggle(labelText, key, onChanged)
    local row    = makeRow(32, labelText)
    local button = makeButton(row, 64, 8, "")
    local function refresh()
        local value = Config[key]
        button.Text = value and "ON" or "OFF"
        button.BackgroundColor3 = value and THEME.Accent or THEME.Off
    end
    button.Activated:Connect(function()
        Config[key] = not Config[key]
        refresh()
        if onChanged then onChanged(Config[key]) end
    end)
    refresh()
end

local function addSlider(labelText, min, max, key, format, onChanged)
    local row = makeRow(50, labelText)
    local valueLabel = create("TextLabel", {
        AnchorPoint      = Vector2.new(1, 0),
        Position         = UDim2.new(1, -10, 0, 0),
        Size             = UDim2.fromOffset(80, 32),
        BackgroundTransparency = 1,
        Font             = Enum.Font.GothamMedium,
        TextSize         = 12,
        TextColor3       = THEME.SubText,
        TextXAlignment   = Enum.TextXAlignment.Right,
        Parent           = row,
    })
    local track = create("Frame", {
        Position         = UDim2.new(0, 10, 0, 36),
        Size             = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = THEME.Off,
        BorderSizePixel  = 0,
        Parent           = row,
    }, { corner(3) })
    local fill = create("Frame", {
        Size             = UDim2.fromScale(0, 1),
        BackgroundColor3 = THEME.Accent,
        BorderSizePixel  = 0,
        Parent           = track,
    }, { corner(3) })
    local knob = create("Frame", {
        AnchorPoint      = Vector2.new(0.5, 0.5),
        Position         = UDim2.fromScale(0, 0.5),
        Size             = UDim2.fromOffset(14, 14),
        BackgroundColor3 = THEME.Text,
        BorderSizePixel  = 0,
        Parent           = track,
    }, { corner(7) })

    local function setFromAlpha(alpha)
        alpha = math.clamp(alpha, 0, 1)
        local value = min + (max - min) * alpha
        Config[key] = value
        fill.Size   = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        valueLabel.Text = format(value)
        if onChanged then onChanged() end
    end

    local dragging = false
    local function update(input)
        setFromAlpha((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
    end

    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    setFromAlpha((Config[key] - min) / (max - min))
end

local function addCycle(labelText, options, getter, setter)
    local row    = makeRow(32, labelText)
    local button = makeButton(row, 110, 8, getter())
    button.BackgroundColor3 = THEME.Accent
    button.Activated:Connect(function()
        local idx = table.find(options, getter()) or 1
        setter(options[idx % #options + 1])
        button.Text = getter()
    end)
end

------------------------------------------------------------------
-- Keybind-Zeile
------------------------------------------------------------------
local listeningForKey = false
local keyHeld = false

local MOUSE_NAMES = {
    [Enum.UserInputType.MouseButton1] = "LMB",
    [Enum.UserInputType.MouseButton2] = "RMB",
    [Enum.UserInputType.MouseButton3] = "MMB",
}

local function keybindName(bind)
    return MOUSE_NAMES[bind] or bind.Name
end

local function inputMatchesBind(input)
    local bind = Config.Keybind
    if bind.EnumType == Enum.UserInputType then
        return input.UserInputType == bind
    end
    return input.KeyCode == bind
end

do
    local row        = makeRow(32, "Aktivierung")
    local modeButton = makeButton(row, 84, 8 + 76, Config.Mode == "Always" and "Immer aktiv" or "Keybind")
    modeButton.BackgroundColor3 = THEME.Accent
    local keyButton  = makeButton(row, 68, 8, keybindName(Config.Keybind))
    keyButton.Visible = Config.Mode == "Keybind"

    row:FindFirstChild("Label").Size = UDim2.new(0, 70, 0, 32)

    modeButton.Activated:Connect(function()
        Config.Mode = Config.Mode == "Always" and "Keybind" or "Always"
        modeButton.Text   = Config.Mode == "Always" and "Immer aktiv" or "Keybind"
        keyButton.Visible = Config.Mode == "Keybind"
        keyHeld = false
    end)

    keyButton.Activated:Connect(function()
        listeningForKey = true
        keyButton.Text  = "..."
    end)

    UserInputService.InputBegan:Connect(function(input)
        if not listeningForKey then return end
        local newBind = nil
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then
                listeningForKey = false
                keyButton.Text  = keybindName(Config.Keybind)
                return
            end
            newBind = input.KeyCode
        elseif input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3 then
            newBind = input.UserInputType
        elseif input.UserInputType.Name:find("Gamepad") and input.KeyCode ~= Enum.KeyCode.Unknown then
            newBind = input.KeyCode
        end
        if newBind then
            Config.Keybind  = newBind
            listeningForKey  = false
            keyHeld          = false
            keyButton.Text   = keybindName(newBind)
        end
    end)
end

