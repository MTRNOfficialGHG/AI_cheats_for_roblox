-- WalkSpeed / JumpPower
------------------------------------------------------------------
local savedDefaults = {
	WalkSpeed = nil :: number?,
	JumpPower = nil :: number?,
	UseJumpPower = nil :: boolean?,
}
local capturingOriginals = false

local function captureOriginals()
	local hum = getHumanoid()
	if hum then
		savedDefaults.WalkSpeed = hum.WalkSpeed
		savedDefaults.JumpPower = hum.JumpPower
		savedDefaults.UseJumpPower = hum.UseJumpPower
	end
end

local function restoreOriginals()
	local hum = getHumanoid()
	if hum and savedDefaults.WalkSpeed then
		hum.WalkSpeed = savedDefaults.WalkSpeed
		hum.JumpPower = savedDefaults.JumpPower :: number
		hum.UseJumpPower = savedDefaults.UseJumpPower :: boolean
	end
end

localPlayer.CharacterAdded:Connect(function(char)
	if Config.WalkSpeedEnabled or Config.JumpPowerEnabled then
		capturingOriginals = true
		task.wait(0.3)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			savedDefaults.WalkSpeed = hum.WalkSpeed
			savedDefaults.JumpPower = hum.JumpPower
			savedDefaults.UseJumpPower = hum.UseJumpPower
		end
		capturingOriginals = false
	end
end)

------------------------------------------------------------------
-- Hitbox Visualizer (BoxHandleAdornment)
------------------------------------------------------------------
local hitboxAdornments: { [BasePart]: BoxHandleAdornment } = {}

local function clearHitboxes()
	for part, adorn in pairs(hitboxAdornments) do
		if adorn and adorn.Parent then adorn:Destroy() end
		hitboxAdornments[part] = nil
	end
end

local function addHitboxForPart(part: BasePart)
	if hitboxAdornments[part] then return end
	local adorn = Instance.new("BoxHandleAdornment")
	adorn.Adornee = part
	adorn.AlwaysOnTop = true
	adorn.ZIndex = 5
	adorn.Transparency = 0.5
	adorn.Color3 = Config.HitboxColor
	adorn.Size = part.Size
	adorn.Parent = part
	hitboxAdornments[part] = adorn
end

local function refreshHitboxes()
	clearHitboxes()
	if not Config.ShowHitboxes then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player == localPlayer then continue end
		local char = player.Character
		if not char then continue end
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				addHitboxForPart(part)
			end
		end
	end
end

local function refreshHitboxColors()
	for _, adorn in pairs(hitboxAdornments) do
		adorn.Color3 = Config.HitboxColor
	end
end

-- Spieler-Events
Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function()
		task.wait(0.2)
		if Config.ShowHitboxes then refreshHitboxes() end
		if Config.HitboxExpander then task.wait(0.2); applyHitboxExpander() end
	end)
end)
Players.PlayerRemoving:Connect(function(p)
	if Config.ShowHitboxes then
		task.defer(refreshHitboxes)
	end
end)

------------------------------------------------------------------
-- Hitbox Expander
------------------------------------------------------------------
local originalSizes: { [BasePart]: Vector3 } = {}

local HITBOX_EXPAND_PARTS = {
	"HumanoidRootPart",
	"Head",
	"Torso",       -- R6
	"UpperTorso",  -- R15
	"LowerTorso",  -- R15
}

function applyHitboxExpander()
	-- Erst alles zurücksetzen
	for part, origSize in pairs(originalSizes) do
		if part and part.Parent then
			part.Size = origSize
		end
		originalSizes[part] = nil
	end

	if not Config.HitboxExpander then return end

	local mult = Config.HitboxExpanderSize
	for _, player in ipairs(Players:GetPlayers()) do
		if player == localPlayer then continue end
		local char = player.Character
		if not char then continue end
		for _, name in ipairs(HITBOX_EXPAND_PARTS) do
			local part = char:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				originalSizes[part] = part.Size
				part.Size = Vector3.new(part.Size.X * mult, part.Size.Y * mult, part.Size.Z * mult)
			end
		end
	end
end

