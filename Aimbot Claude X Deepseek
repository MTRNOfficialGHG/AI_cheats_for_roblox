------------------------------------------------------------------
-- Hauptschleife
------------------------------------------------------------------
RunService:BindToRenderStep("SmartTargetingLoop", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local center = getAimCenter()
	local now = os.clock()

	-- FOV-Kreis
	if fovCircle then
		fovCircle.Visible = Config.ShowFOV
		if Config.ShowFOV then
			fovCircle.Position = Vector2.new(center.X, center.Y + guiInset.Y)
			fovCircle.Radius = Config.Radius
			fovCircle.Color = Config.FOVColor
		end
	end

	-- WalkSpeed / JumpPower im Loop anwenden (falls aktiv)
	if not capturingOriginals then
		local hum = getHumanoid()
		if hum then
			if Config.WalkSpeedEnabled and math.abs(hum.WalkSpeed - Config.WalkSpeed) > 0.01 then
				hum.WalkSpeed = Config.WalkSpeed
			end
			if Config.JumpPowerEnabled then
				if not hum.UseJumpPower then hum.UseJumpPower = true end
				if math.abs(hum.JumpPower - Config.JumpPower) > 0.01 then
					hum.JumpPower = Config.JumpPower
				end
			end
		end
	end

	-- ESP
	if hasDrawing then
		if Config.ESP then
			for _, player in ipairs(Players:GetPlayers()) do
				updateEspForPlayer(player)
			end
		else
			for _, cache in pairs(espCache) do
				hideEspCache(cache)
			end
		end
	end

	-- Aim Assist
	if not Config.Enabled then return end
	if Config.Mode == "Keybind" and not keyHeld then return end

	local target = getTargetCached(now)
	if not target then return end

	local goal = CFrame.lookAt(camera.CFrame.Position, target.Position)
	local alpha = 1 - (Config.Smoothing * 0.97) ^ (dt * 60)
	camera.CFrame = camera.CFrame:Lerp(goal, alpha)
end)

